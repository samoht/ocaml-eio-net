(executable
 (name fuzz)
 (libraries eio-net eio-net.framing eio eio.mock cstruct alcobar fmt))

(rule
 (alias runtest)
 (package eio-net)
 (enabled_if
  (<> %{profile} afl))
 (deps fuzz.exe)
 (action
  (run %{exe:fuzz.exe} --repeat 100 --budget 0 --timeout 0)))

(rule
 (alias chaos)
 (package eio-net)
 (deps fuzz.exe)
 (action
  (run %{exe:fuzz.exe} --repeat 5000 --budget 0 --timeout 0)))

(rule
 (alias fuzz)
 (package eio-net)
 (enabled_if
  (= %{profile} afl))
 (deps fuzz.exe)
 (action
  (progn
   (run %{exe:fuzz.exe} --gen-corpus corpus)
   (run afl-fuzz -V 60 -i corpus -o _fuzz -- %{exe:fuzz.exe} @@))))
