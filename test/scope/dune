(copy_files#
 (files ../../lib/mem/scope.{ml,mli}))

(library
 (name mem_scope)
 (wrapped false)
 (modules scope)
 (libraries eio))

(executable
 (name readme)
 (modules readme)
 (libraries mem_scope fmt))

(test
 (name test)
 (package eio-net)
 (modules test test_scope)
 (libraries
  mem_scope
  eio-net.mem
  eio
  eio.mock
  eio.unix
  cstruct
  mtime
  unix
  alcotest
  fmt))

(rule
 (with-stdout-to
  README.md.scope
  (run ./readme.exe %{dep:../../README.md})))

(rule
 (alias runtest)
 (package eio-net)
 (action
  (diff ../../README.md README.md.scope)))
