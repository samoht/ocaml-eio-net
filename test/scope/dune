(copy_files#
 (files ../../lib/mem/scope.{ml,mli}))

(library
 (name mem_scope)
 (wrapped false)
 (modules scope)
 (libraries eio))

(executable
 (name model)
 (modules model)
 (libraries mem_scope fmt))

(test
 (name test)
 (package eio-net)
 (modules test test_scope)
 (libraries
  mem_scope
  eio-net.mem
  eio
  eio.mock
  eio.unix
  cstruct
  mtime
  unix
  alcotest
  fmt))

(rule
 (with-stdout-to
  MODEL.md.scope
  (run ./model.exe %{dep:../../MODEL.md})))

(rule
 (alias runtest)
 (package eio-net)
 (action
  (diff ../../MODEL.md MODEL.md.scope)))
