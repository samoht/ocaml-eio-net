; gen.exe writes rebuilt.ml, which builds each schedule from the text pp
; printed for it and fails unless it prints the same text again.

(executable
 (name gen)
 (modules gen)
 (libraries eio-net.chaos fmt))

(rule
 (with-stdout-to
  rebuilt.ml
  (run ./gen.exe)))

(executable
 (name rebuilt)
 (modules rebuilt)
 (libraries eio-net.chaos fmt))

(rule
 (alias runtest)
 (package eio-net)
 (action
  (run ./rebuilt.exe)))
