(rule
 (alias regen)
 (mode promote)
 (enabled_if
  (= %{env:REGEN=0} 1))
 (targets
  tcp4.csv
  tcp6.csv
  unix-stream.csv
  udp4.csv
  udp6.csv
  unix-dgram.csv
  scenarios.csv)
 (deps
  ../scripts/record.exe
  (source_tree ../scripts))
 (action
  (run bash ../scripts/generate.sh . ../scripts/record.exe)))
