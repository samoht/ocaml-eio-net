; eio-net: generic Eio networking primitives. Frame is the bidirectional
; packet-channel carrier that frame-based protocols (CCSDS, AX.25, Ethernet)
; read and write over, independent of the underlying transport.

(library
 (name eio_net)
 (public_name eio-net)
 (libraries
  net-framing
  hermetic.eio
  eio-net.accept
  eio
  cstruct
  fmt
  logs
  bytesrw
  mtime
  nox-rope)
 (flags
  (:standard -open Hermetic_eio)))
