; Linked whole: its initialisation registers the Unix connect and accept
; classifiers, which a program that never names Eio_net_unix still dials and
; listens with.

(library
 (name eio_net_unix)
 (public_name eio-net.unix)
 (libraries
  eio-net
  eio-net.connect
  eio-net.accept
  eio
  eio.unix
  cstruct
  fpath
  ipaddr
  unix)
 (library_flags (-linkall))
 (foreign_stubs
  (language c)
  (names sendmsg_batch writev_offload local_connect interface_stubs)))
