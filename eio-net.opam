# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Eio network backends and test helpers"
description: """
Frame channels for Eio over datagram sockets, length-prefixed streams
and in-memory pairs. An in-memory network, and a check that runs a
workload on it under network faults, test protocols without real
sockets. POSIX adapters add batched datagrams, Unix-domain sockets
and interface addresses.
"""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["eio" "network" "framing" "test"]
homepage: "https://github.com/samoht/ocaml-eio-net"
bug-reports: "https://github.com/samoht/ocaml-eio-net/issues"
depends: [
  "dune" {>= "3.21"}
  "hermetic" {>= "0.1.0"}
  "ocaml" {>= "5.3"}
  "eio" {>= "1.6"}
  "cstruct" {>= "6.0.0"}
  "fmt"
  "logs"
  "bytesrw" {>= "0.2.0"}
  "mtime" {>= "2.0.0"}
  "psq" {>= "0.2.0"}
  "domain-local-await" {>= "0.1.0"}
  "ipaddr" {>= "5.3.0"}
  "fpath"
  "conf-linux-libc-dev" {os = "linux"}
  "alcotest" {with-test}
  "alcobar" {with-test}
  "ohex" {with-test}
  "eio_main" {with-test}
  "eio_posix" {with-test}
  "mdx" {with-test & >= "2.3.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-eio-net.git"
x-maintenance-intent: ["(latest)"]
available: os != "win32"
