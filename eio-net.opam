# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Network tests and channels for Eio"
description: """
eio-net tests Eio code against a network, and gives programs frame
channels to build on. Eio_net_chaos.run runs a program again and again on an
in-memory network, each time with a different fault, and restarts it on what
the fault left. Eio_net_chaos.device checks that an Eio network answers as
Linux or macOS does; the in-memory network follows either kernel and passes
it. The frame channels run over datagram sockets and byte streams, in which
one receive is one frame, beside an accept loop and a relay."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["eio" "test" "chaos" "network" "framing"]
homepage: "https://github.com/samoht/ocaml-eio-net"
bug-reports: "https://github.com/samoht/ocaml-eio-net/issues"
depends: [
  "dune" {>= "3.21"}
  "hermetic" {>= "0.1.0"}
  "ocaml" {>= "5.4"}
  "eio" {>= "1.7"}
  "cstruct" {>= "6.2.0"}
  "fmt"
  "logs"
  "bytesrw" {>= "0.2.0"}
  "mtime" {>= "2.0.0"}
  "eio-chaos" {>= "0.1.0" & < "0.2.0"}
  "ipaddr" {>= "5.3.0"}
  "fpath"
  "conf-linux-libc-dev" {os = "linux"}
  "alcotest" {with-test & >= "1.7.0"}
  "alcobar" {with-test}
  "ohex" {with-test}
  "eio_main" {with-test & >= "1.7"}
  "eio_posix" {with-test & >= "1.7"}
  "mdx" {with-test & >= "2.3.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-eio-net.git"
x-maintenance-intent: ["(latest)"]
available: os != "win32"
# eio-chaos is not on opam yet: drop once eio-chaos is released.
pin-depends: [
  ["eio-chaos.0.1.0" "git+https://github.com/samoht/ocaml-eio-chaos.git#b6b7c5cbb2e9c82e487a33eef553f3506211ae5d"]
]
