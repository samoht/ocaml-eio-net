# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Eio network backends and test helpers"
description: """
Network channels, relays and test backends for Eio: a frame channel where one
   receive is one frame, over a datagram socket, a length-prefixed flow or an
   in-memory pair; an addressed datagram channel; a bidirectional relay; an
   in-memory network and a fault-injecting wrapper for tests; and batched
   datagram transfers on POSIX sockets."""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["eio" "network" "test"]
homepage: "https://github.com/samoht/ocaml-eio-net"
bug-reports: "https://github.com/samoht/ocaml-eio-net/issues"
depends: [
  "dune" {>= "3.21"}
  "hermetic" {>= "0.1.0"}
  "net-framing" {= version}
  "ocaml" {>= "5.3"}
  "eio" {>= "1.6"}
  "cstruct" {>= "6.0.0"}
  "fmt"
  "logs"
  "bytesrw"
  "mtime"
  "ipaddr" {>= "5.3.0"}
  "fpath"
  "alcotest" {with-test}
  "eio_main" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-eio-net.git"
x-maintenance-intent: ["(latest)"]
