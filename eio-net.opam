# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Network tests and channels for Eio"
description: """
Answers two questions, with one call each: does an Eio program cope
with a network that fails, and does an Eio network answer as Linux or
macOS does? The first runs on an in-memory network that follows either
kernel and itself passes the second.
"""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["eio" "network" "framing" "test"]
homepage: "https://github.com/samoht/ocaml-eio-net"
bug-reports: "https://github.com/samoht/ocaml-eio-net/issues"
depends: [
  "dune" {>= "3.21"}
  "hermetic" {>= "0.1.0"}
  "ocaml" {>= "5.4"}
  "eio" {>= "1.7"}
  "cstruct" {>= "6.0.0"}
  "fmt"
  "logs"
  "bytesrw" {>= "0.2.0"}
  "mtime" {>= "2.0.0"}
  "eio-chaos"
  "ipaddr" {>= "5.3.0"}
  "fpath"
  "conf-linux-libc-dev" {os = "linux"}
  "alcotest" {with-test & >= "1.7.0"}
  "alcobar" {with-test}
  "ohex" {with-test}
  "eio_main" {with-test & >= "1.7"}
  "eio_posix" {with-test & >= "1.7"}
  "mdx" {with-test & >= "2.3.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-eio-net.git"
x-maintenance-intent: ["(latest)"]
available: os != "win32"
# eio-chaos is not on opam yet: drop once eio-chaos is released.
pin-depends: [
  ["eio-chaos.dev" "git+https://github.com/samoht/ocaml-eio-chaos.git#6c07eac4a94475334d8afb21d5e4d05de8676dbf"]
]
