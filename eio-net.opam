# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Network channels and chaos tests for Eio"
description: """
Tests protocols without real sockets: an in-memory network following
Linux or macOS, and a check that runs a workload on it under network
faults.
"""
maintainer: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
authors: ["Thomas Gazagnaire <thomas@gazagnaire.org>"]
license: "ISC"
tags: ["eio" "network" "framing" "test"]
homepage: "https://github.com/samoht/ocaml-eio-net"
bug-reports: "https://github.com/samoht/ocaml-eio-net/issues"
depends: [
  "dune" {>= "3.21"}
  "hermetic" {>= "0.1.0"}
  "ocaml" {>= "5.4"}
  "eio" {>= "1.7"}
  "cstruct" {>= "6.0.0"}
  "fmt"
  "logs"
  "bytesrw" {>= "0.2.0"}
  "mtime" {>= "2.0.0"}
  "psq" {>= "0.2.0"}
  "domain-local-await" {>= "0.1.0"}
  "ipaddr" {>= "5.3.0"}
  "fpath"
  "conf-linux-libc-dev" {os = "linux"}
  "alcotest" {with-test & >= "1.7.0"}
  "alcobar" {with-test}
  "ohex" {with-test}
  "eio_main" {with-test & >= "1.7"}
  "eio_posix" {with-test & >= "1.7"}
  "mdx" {with-test & >= "2.3.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/samoht/ocaml-eio-net.git"
x-maintenance-intent: ["(latest)"]
available: os != "win32"
# Eio 1.7 (ocaml/opam-repository#31253) and the uring 2.15.1 its eio_linux
# needs are not on opam yet.
pin-depends: [
  ["eio.1.7" "git+https://github.com/ocaml-multicore/eio.git#v1.7"]
  ["eio_posix.1.7" "git+https://github.com/ocaml-multicore/eio.git#v1.7"]
  ["eio_main.1.7" "git+https://github.com/ocaml-multicore/eio.git#v1.7"]
  ["eio_linux.1.7" "git+https://github.com/ocaml-multicore/eio.git#v1.7"]
  ["uring.2.15.1" "git+https://github.com/ocaml-multicore/ocaml-uring.git#v2.15.1"]
]
